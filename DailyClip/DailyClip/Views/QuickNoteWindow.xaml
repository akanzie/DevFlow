<Window
    x:Class="DailyClip.Views.QuickNoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyClip.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Quick Note"
    Width="500"
    Height="350"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    Background="Transparent"
    AllowsTransparency="True">

    <Window.Resources>
        <AcrylicBrush x:Key="AcrylicBackgroundBrush" BackgroundSource="Backdrop" TintColor="Black" TintOpacity="0.8" FallbackColor="Black"/>
    </Window.Resources>

    <Border CornerRadius="8" Background="{StaticResource AcrylicBackgroundBrush}" BorderBrush="#FF4A4A4A" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Quick Note"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,12"/>

            <!-- Note Text Box -->
            <TextBox x:Name="NoteTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     FontSize="14"
                     Margin="0,0,0,12"
                     GotFocus="NoteTextBox_GotFocus"
                     KeyDown="NoteTextBox_KeyDown"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        Foreground="#FFCCCCCC"
                        BorderBrush="#FF666666"
                        BorderThickness="1"
                        CornerRadius="4"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton"
                        Content="Save"
                        Background="#FF0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="4"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
