<Window
    x:Class="DailyClip.Views.QuickSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyClip.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Quick Search"
    Width="600"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    Background="Transparent"
    AllowsTransparency="True">

    <Window.Resources>
        <AcrylicBrush x:Key="AcrylicBackgroundBrush" BackgroundSource="Backdrop" TintColor="Black" TintOpacity="0.8" FallbackColor="Black"/>
    </Window.Resources>

    <Border CornerRadius="8" Background="{StaticResource AcrylicBackgroundBrush}" BorderBrush="#FF4A4A4A" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <TextBox x:Name="SearchTextBox"
                     Grid.Row="0"
                     Margin="0,0,0,12"
                     PlaceholderText="Search clipboard history..."
                     FontSize="16"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     Foreground="White"
                     BorderBrush="#FF666666"
                     GotFocus="SearchTextBox_GotFocus"
                     TextChanged="SearchTextBox_TextChanged"
                     KeyDown="SearchTextBox_KeyDown"/>

            <!-- Results List -->
            <ListView x:Name="ResultsListView"
                      Grid.Row="1"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="ResultsListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Content Preview -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Preview}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       Foreground="White"
                                       FontSize="14"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</Window>
